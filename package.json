{
  "name": "kita-down-detector",
  "version": "0.1.0",
  "private": true,
  "description": "Datensparsames Tracking von Notbetreuung und eingeschränkter Betreuung in Kitas (zuerst NRW)",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.ts",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.ts",
    "test": "node --disable-warning=ExperimentalWarning --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "seed": "node --disable-warning=ExperimentalWarning scripts/seed-testdaten.ts",
    "import:osm": "node --disable-warning=ExperimentalWarning scripts/import-osm-nrw.ts",
    "link:create": "node --disable-warning=ExperimentalWarning scripts/link-create.ts",
    "cleanup": "node --disable-warning=ExperimentalWarning scripts/cleanup.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.9",
    "altcha": "^3.6.0",
    "altcha-lib": "^2.9.0",
    "hono": "^4.13.19",
    "nodemailer": "^10.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "typescript": "^7.0.2"
  }
}
