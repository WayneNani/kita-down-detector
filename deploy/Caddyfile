# TLS automatisch (Let's Encrypt).
# Keine IP-Adressen in Logs: Zugriffs-Logs sind aus (kein „log“-Block) und das
# Fehler-Log von HTTP-Anfragen (enthält remote_ip und Header) wird verworfen.
{
	log default {
		exclude http.log.access http.log.error
	}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		-Server
	}

	# Interne Prüfpfade nicht nach außen geben
	@intern path /healthz /readyz
	respond @intern 404

	reverse_proxy app:8080
}
